# Database (Neon)
DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# JWT
JWT_SECRET="generate-a-random-secret"
JWT_REFRESH_SECRET="generate-another-random-secret"
BCRYPT_SALT_ROUNDS=12

# CORS (comma-separated, e.g. https://jeemocks.vercel.app,https://jeemocks.com)
CORS_ORIGINS="http://localhost:3000"

# Redis (optional — cache degrades gracefully)
REDIS_URL="redis://localhost:6379"

# AWS S3 (optional — for question images)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_BUCKET_NAME=""
AWS_REGION="ap-south-1"

# Razorpay (optional — payments)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# OTP / SMS (optional — dev logs to console)
OTP_PROVIDER_KEY=""
OTP_SENDER_ID="JEETST"

# Frontend (used by Next.js)
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
NEXT_PUBLIC_MATHJAX_VERSION="3"
